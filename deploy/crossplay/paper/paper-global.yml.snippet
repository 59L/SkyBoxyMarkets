# Merge into config/paper-global.yml on the SkyBoxy backend.
proxies:
  velocity:
    enabled: true
    # The proxy runs with online-mode = false (cracked accounts are allowed).
    online-mode: false
    # Paste the contents of Velocity's forwarding.secret here. Keep it out of git.
    secret: 'PASTE_VELOCITY_FORWARDING_SECRET'

# Merge into plugins/ViaVersion/config.yml on the SkyBoxy backend.
# Install ViaVersion + ViaBackwards on the backend, not on Velocity.

# Supported Java range: every 1.21.x release (1.21 through 1.21.11) up to the
# server's own version. Older clients get the message below instead of a broken session.
blocked-versions: ["<1.21"]
block-disconnect-msg: "Please join with Minecraft Java 1.21 or newer, or use Bedrock Edition."

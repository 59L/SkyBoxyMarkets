# Merge these keys into the velocity.toml that Velocity generates on first start.
# Do not replace the whole file: keep its config-version and any keys not listed here.

bind = "0.0.0.0:25565"

# Must be false so cracked (non-Mojang) accounts can connect at all. LibreLogin
# turns Mojang authentication back on per connection for premium accounts, and
# Geyser/Floodgate authenticate Bedrock players through Xbox Live.
online-mode = false

# Cracked and Bedrock clients cannot present a Mojang-signed chat key.
force-key-authentication = false

# Modern forwarding is the only mode that authenticates the proxy to the backend.
# forwarding.secret is generated by Velocity; never commit it.
player-info-forwarding-mode = "modern"
forwarding-secret-file = "forwarding.secret"

[servers]
# Both backends listen on loopback only (see ../paper and ../limbo).
limbo = "127.0.0.1:25567"
skyboxy = "127.0.0.1:25566"

# Fail closed: if LibreLogin is missing or broken, players land in the limbo
# (where nothing can be done) rather than on the real server unauthenticated.
# LibreLogin moves them to its configured lobby after login.
try = ["limbo"]

[forced-hosts]
# Remove the example forced hosts Velocity generates, or point them at "limbo".
